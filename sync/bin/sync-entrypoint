#!/usr/bin/env bash
# Container entrypoint. As root it prepares $DATA_DIR and the SSH key, then runs the command
# again as PUID:PGID (Unraid's nobody:users by default), so files on the volume aren't root's.
#
#   schedule          (default) sync every hour at SYNC_MINUTE past the hour (UTC), and serve
#                     the status page on WEB_PORT
#   once [args...]    one sync now; args go to scripts/run-fetch-decorations.mjs
#   <command>         any other command, as PUID:PGID (e.g. bash)
set -euo pipefail

export HOME="$DATA_DIR/home"
SSH_KEY_FILE=${SSH_KEY_FILE:-$DATA_DIR/deploy_key}

if [[ $(id -u) -eq 0 && $PUID -ne 0 ]]; then
  # ssh refuses to run as a uid with no account ("No user exists for uid 99").
  if ! getent group "$PGID" >/dev/null; then
    echo "homestead:x:$PGID:" >>/etc/group
  fi
  if ! getent passwd "$PUID" >/dev/null; then
    echo "homestead:x:$PUID:$PGID::$HOME:/usr/sbin/nologin" >>/etc/passwd
  fi
  mkdir -p "$HOME/.ssh"
  # ssh won't use a key that others can read, and the sync user can't read a root-owned one,
  # so copy it into the sync user's home with the right owner and mode.
  if [[ -f $SSH_KEY_FILE ]]; then
    install -m 600 -o "$PUID" -g "$PGID" "$SSH_KEY_FILE" "$HOME/.ssh/id_sync"
  fi
  chown "$PUID:$PGID" "$DATA_DIR" "$HOME" "$HOME/.ssh"
  for file in "$DATA_DIR/sync.lock" "$DATA_DIR/last-success"; do
    [[ -e $file ]] && chown "$PUID:$PGID" "$file"
  done
  # After a PUID change, hand the clone and run history over too (git refuses a repo another
  # user owns).
  for dir in "$DATA_DIR/repo" "$DATA_DIR/runs"; do
    if [[ -d $dir && $(stat -c %u "$dir") != "$PUID" ]]; then
      echo "Changing the owner of $dir to $PUID:$PGID..."
      chown -R "$PUID:$PGID" "$dir"
    fi
  done
  exec setpriv --reuid="$PUID" --regid="$PGID" --clear-groups -- "$0" "$@"
fi

export SYNC_PREPARED=1
mkdir -p "$HOME/.ssh"
if [[ $PUID -eq 0 && -f $SSH_KEY_FILE ]]; then
  install -m 600 "$SSH_KEY_FILE" "$HOME/.ssh/id_sync"
fi

# Rewritten on every start, so changing the container's settings takes effect.
git config --global user.name "$GIT_USER_NAME"
git config --global user.email "$GIT_USER_EMAIL"
git config --global pull.rebase true
if [[ -f $HOME/.ssh/id_sync ]]; then
  git config --global core.sshCommand \
    "ssh -i $HOME/.ssh/id_sync -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes"
else
  git config --global --unset core.sshCommand || true
fi
# A token is read from the environment when git asks, never written to disk.
if [[ -n ${GITHUB_TOKEN:-} ]]; then
  git config --global credential.https://github.com.helper \
    '!f() { test "$1" = get && echo username=x-access-token && echo "password=$GITHUB_TOKEN"; }; f'
else
  git config --global --unset credential.https://github.com.helper || true
fi

case "${1:-schedule}" in
  schedule)
    # The status page runs beside the schedule; tini stops both together.
    if [[ -n ${WEB_PORT:-} && $WEB_PORT != off ]]; then
      sync-web &
    fi
    exec sync-schedule
    ;;
  once) shift; exec sync-once "$@" ;;
  *) exec "$@" ;;
esac
