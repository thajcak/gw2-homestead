#!/usr/bin/env bash
# Opt-in pre-push check for GitHub Actions changes. Enable with:
#   git config core.hooksPath .githooks
#
# When the pushed commits touch .github/ or scripts/, dry-runs every workflow trigger with act
# (scripts/act.sh check). Set ACT_E2E=1 to also run the deploy workflow's build end to end.
# Skips with a warning when act or Docker isn't available; bypass once with git push --no-verify.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
changed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # branch deletion
  if [[ $remote_sha == "$zero" ]]; then
    range="origin/main..$local_sha" # new branch: compare with main
    git rev-parse -q --verify origin/main >/dev/null || range=$local_sha
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" -- .github scripts 2>/dev/null | grep -q .; then
    changed=1
  fi
done

[[ $changed -eq 1 ]] || exit 0

if ! command -v act >/dev/null || ! docker info >/dev/null 2>&1; then
  echo "pre-push: workflows changed but act/Docker is unavailable; skipping local Actions check." >&2
  exit 0
fi

if [[ ${ACT_E2E:-0} == 1 ]]; then
  scripts/act.sh all
else
  scripts/act.sh check
fi
